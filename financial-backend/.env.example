# Pooler Neon (hostname com -pooler) — usado pela aplicação
DATABASE_URL=
# Conexão direta (sem -pooler) — usada apenas por `npm run migrate`
DATABASE_URL_DIRECT=
DB_POOL_MAX=20
# SSL estrito habilitado por padrão para bancos remotos (desativado apenas se false explícito)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=
GOOGLE_CLIENT_ID=
FRONTEND_DEV_URL=http://localhost:5173
FRONTEND_PROD_URL=

# IA hospedada gratuita (Cloudflare Workers Free: 10.000 Neurons/dia, sem cartão)
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Segunda opção gratuita opcional (Groq Free Tier, sem cartão)
GROQ_API_KEY=
GROQ_AI_MODEL=llama-3.1-8b-instant

AI_USER_DAILY_LIMIT=20

